# Server-only settings. Copy locally to .env; never commit real values.
# Use the provider-issued PostgreSQL pooler URL for serverless deployments.
# URL-encode the password. Preserve TLS options supplied by the provider.
DATABASE_URL=postgresql://USERNAME:URL_ENCODED_PASSWORD@HOST:5432/DATABASE?sslmode=require
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
PORT=3000
CLIENT_URL=http://localhost:5173
# Local QA/app launchers generate their own private signing secrets.
# Demo seeding is disabled by default. Never enable it on a real user database.
